static func tile(terrain: String) -> PackedScene:
	return load(TILES[terrain]) as PackedScene


## A ready-scaled instance of a prop.
static func prop(key: String) -> Node3D:
	var n := (load(PROPS[key][0]) as PackedScene).instantiate() as Node3D
	n.scale = Vector3.ONE * float(PROPS[key][1])
	return n
