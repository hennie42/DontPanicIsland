class_name NickFilter
extends RefCounted
## Leaderboard nicknames: 1-5 chars A-Z 0-9. The blocklist (data/blocked_words.json) is the same one the database
## enforces (supabase/migrations/*_blocklist.sql, generated by tools/make_blocklist_sql.py); this copy gives the
## player instant feedback.

const MAX_LEN := 5
const LEET_FROM := "0134578"
const LEET_TO := "OIEASTB"

static var _contains: PackedStringArray = []
static var _exact: PackedStringArray = []
static var _loaded := false


## Upper-case, drop everything outside A-Z 0-9, cut to 5 chars.
static func clean(s: String) -> String:
	var out := ""
	for ch in s.to_upper():
		if (ch >= "A" and ch <= "Z") or (ch >= "0" and ch <= "9"):
			out += ch
	return out.substr(0, MAX_LEN)


## Leetspeak digits to the letters they imitate (normalize_nick() in the database).
static func normalize(s: String) -> String:
	var out := ""
	for ch in s.to_upper():
		var i := LEET_FROM.find(ch)
		out += LEET_TO[i] if i >= 0 else ch
	return out


static func is_ok(s: String) -> bool:
	if s.is_empty() or s.length() > MAX_LEN or clean(s) != s:
		return false
	_load()
	var n := normalize(s)
	if n in _exact:
		return false
	for w in _contains:
		if n.contains(w):
			return false
	return true


static func _load() -> void:
	if _loaded:
		return
	_loaded = true
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://data/blocked_words.json"))
	if not data is Dictionary:
		push_error("NickFilter: data/blocked_words.json missing or invalid")
		return
	for w in data["words"]:
		var word := String(w)
		if word.begins_with("="):
			_exact.append(word.substr(1))
		else:
			_contains.append(word)
